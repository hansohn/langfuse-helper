#-------------------------------------------------------------------------------
# Langfuse docker compose configuration -- REFERENCE
#-------------------------------------------------------------------------------
#
# This file documents every variable this repo's Makefile writes into `.env`,
# with placeholder values. It is safe to commit; `.env` is NOT (see .gitignore).
#
# You normally never copy this file. `make langfuse/env` generates a `.env` with
# cryptographically random secrets, which is always preferable to editing
# placeholders by hand:
#
#     make dev/up         # clone + generate .env + start + wait
#
# Copy it only when you need to pin a value the generator would randomize (a
# shared team deployment, a fixed ENCRYPTION_KEY, an external database):
#
#     cp .env.example .env && chmod 600 .env
#     # replace EVERY <...> placeholder below, then:
#     make dev/up
#
# Anything left as a placeholder will be passed to the containers verbatim and
# will fail at runtime. Do not deploy this file as-is.
#
# Generate a secret:            openssl rand -hex 32
# Regenerate all of them:       make langfuse/env FORCE=true
#
# Hostnames below (postgres, clickhouse, redis, minio) are compose *service*
# names resolved on the compose network. Do not change them to localhost --
# upstream's own .env.*.example files use different names (e.g. `db`) because
# they target a source checkout, not this compose deployment.
#-------------------------------------------------------------------------------

# --- web ---
# NEXTAUTH_URL must match the URL you actually browse to, including port, or
# login callbacks fail. For remote access set the reachable address, e.g.
# http://10.0.0.5:3000 (also pass LANGFUSE_URL=... so `make langfuse/wait` and
# the health poll target the same host).
NEXTAUTH_URL=http://localhost:3000

# Session signing key.
NEXTAUTH_SECRET=<openssl rand -hex 32>

# SALT hashes Langfuse API keys; ENCRYPTION_KEY encrypts stored LLM credentials.
# Both are bound to the DATA, not the deployment: change either and existing
# API keys stop authenticating and stored credentials become unreadable. Back
# them up with your volumes -- `make langfuse/backup` saves them alongside the
# dumps, and `make langfuse/restore` reinstates them.
# ENCRYPTION_KEY must be exactly 64 hex chars (32 bytes).
SALT=<openssl rand -hex 32>
ENCRYPTION_KEY=<openssl rand -hex 32>

# Anonymous usage telemetry to Langfuse. Set false to disable.
TELEMETRY_ENABLED=true

# --- postgres ---
# POSTGRES_PASSWORD initialises the database volume on FIRST start only. Once
# the volume exists the password is baked into it, so changing this value later
# locks the app out until you delete the volume (`make docker/clean`).
# The password inside DATABASE_URL must match POSTGRES_PASSWORD.
POSTGRES_PASSWORD=<openssl rand -hex 24>
DATABASE_URL=postgresql://postgres:<same as POSTGRES_PASSWORD>@postgres:5432/postgres

# --- clickhouse ---
# Stores traces and observations. Same first-start volume caveat as postgres.
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=<openssl rand -hex 24>

# --- redis ---
# Ingestion queue. Passed to redis as --requirepass.
REDIS_AUTH=<openssl rand -hex 24>

# --- minio (s3) ---
# Blob storage for events, media and batch exports. ALL FOUR values below must
# be identical: MINIO_ROOT_PASSWORD is what the minio server accepts, and the
# three LANGFUSE_S3_* keys are what web and worker authenticate with. A mismatch
# fails at upload time, not at startup, so it is easy to miss.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=<openssl rand -hex 24>
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=<same as MINIO_ROOT_PASSWORD>
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=<same as MINIO_ROOT_PASSWORD>
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=<same as MINIO_ROOT_PASSWORD>

#-------------------------------------------------------------------------------
# Optional: headless bootstrap
#-------------------------------------------------------------------------------
# `make langfuse/env` WRITES these by default, filling the email from
# `git config user.email` and generating the password and key pair. What you see
# below is the shape of what it writes; you normally do not edit it by hand.
#
# HEADLESS=false suppresses it, leaving a stack with zero users that you sign up to
# through the UI. Override individual values with HEADLESS_EMAIL=...,
# HEADLESS_PROJECT_ID=... and so on.
#
# Applied by the web container only when the user does not already exist, so it is
# a first-run bootstrap, not ongoing config.
#
# After uncommenting and filling these in, apply them with:
#     make langfuse/bootstrap
#
# Editing this file does NOT affect a running container -- environment is fixed
# at container creation. langfuse/bootstrap recreates the app services for you,
# refuses to run if a required value is missing, and warns instead of silently
# doing nothing when a user already exists (Langfuse only provisions once).
#
# Treat the keys below as real credentials: anything committed here is public.
#
# LANGFUSE_INIT_ORG_ID=my-org
# LANGFUSE_INIT_ORG_NAME=My Org
# LANGFUSE_INIT_PROJECT_ID=my-project
# LANGFUSE_INIT_PROJECT_NAME=My Project
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-<openssl rand -hex 16>
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-<openssl rand -hex 16>
# LANGFUSE_INIT_USER_EMAIL=you@example.com
# LANGFUSE_INIT_USER_NAME=Your Name
# LANGFUSE_INIT_USER_PASSWORD=<at least 8 chars>

#-------------------------------------------------------------------------------
# Optional: coding agent tracing
#-------------------------------------------------------------------------------
# Claude Code and Codex sessions are traced by each harness's official Langfuse
# plugin, which reads the transcript and emits one trace per turn carrying the
# conversation, cost, and skill tags. See "Tracing coding agents" in the README.
# Choose harnesses with TRACE_HARNESSES (default: claude).
#
# Claude Code needs `uv` on PATH (brew install uv) -- the plugin's hook declares its
# langfuse dependency as PEP 723 metadata and is run with `uv run --script`.
# Without uv the import fails and tracing stops SILENTLY. Codex needs Node.js 22+
# and npm. 'make trace/check' verifies them.
#
# The plugins do NOT read this file: their credentials live in their own
# machine-scope config (Claude Code's credential store -- the macOS Keychain or
# ~/.claude/.credentials.json -- and ~/.codex/langfuse.json mode 600 for Codex). The pairs below are written by 'make trace/project' -- one
# per harness -- and exist so that target can tell whether the project and keys
# already exist, and so 'make trace/install' can configure each plugin.
#
# One project holds every repo's and harness's traces. Langfuse documents separate
# projects for access control only, and splitting would make "how does this skill
# behave across my repos" unanswerable. Repos and harnesses are told apart by
# repo:<name> and harness:<name> trace tags ('make trace/tag').
#
# LANGFUSE_TRACE_CLAUDE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_TRACE_CLAUDE_SECRET_KEY=sk-lf-...
# LANGFUSE_TRACE_CODEX_PUBLIC_KEY=pk-lf-...
# LANGFUSE_TRACE_CODEX_SECRET_KEY=sk-lf-...
#
# Optional. Display name of the project 'make trace/project' creates when none is
# found. It looks up LANGFUSE_INIT_PROJECT_ID first, so renaming the project in
# the UI never creates a second one.
# LANGFUSE_TRACE_PROJECT_NAME=Coding Agents
#
# Optional. Claude Code's plugin does not set Langfuse's environment field, but the
# Langfuse SDK reads this variable itself, so setting it in the plugin config or a
# shell profile works (Codex has an `environment` key in langfuse.json). One
# project holds all environments; do not split by project.
# LANGFUSE_TRACING_ENVIRONMENT=development

#-------------------------------------------------------------------------------
# Optional: v3 SDK compatibility
#-------------------------------------------------------------------------------
# This deploys Langfuse v4, which ingests via OTLP (/api/public/otel/v1/traces)
# or a v4 SDK. Older SDKs posting trace events to /api/public/ingestion are
# rejected with "Event type ... is not accepted ... when
# LANGFUSE_MIGRATION_V4_WRITE_MODE is events_only", and the public
# GET /api/public/traces read endpoint is disabled in that mode.
#
# As a temporary migration bridge for a v2/v3 SDK you cannot upgrade yet, set
# this on BOTH web and worker (it is a shared compose env, so one line does
# both) and recreate them. Untested in this repo.
#
# LANGFUSE_MIGRATION_V4_WRITE_MODE=dual

#-------------------------------------------------------------------------------
# Optional: email (invites, password resets)
#-------------------------------------------------------------------------------
# Unset by default, which is why signup needs no email verification. Set both
# to enable transactional email.
#
# EMAIL_FROM_ADDRESS=langfuse@example.com
# SMTP_CONNECTION_URL=smtp://user:pass@smtp.example.com:587
